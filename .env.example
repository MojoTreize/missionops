# Exemple de variables d'environnement — copier vers .env et compléter.
# Ne jamais committer .env.

# Base de données PostgreSQL (région UE)
# En local avec docker-compose : postgresql://missionops:missionops@localhost:5432/missionops
DATABASE_URL="postgresql://missionops:missionops@localhost:5432/missionops"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentification (à définir en B1.5)
# AUTH_SECRET=""

# Stockage objet compatible S3 (région UE, à définir en B3.6)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Sentry (région UE, à définir en B8.4)
# SENTRY_DSN=""
