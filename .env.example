# Exemple de variables d'environnement — copier vers .env et compléter.
# Ne jamais committer .env.

# Base de données PostgreSQL (région UE)
# En local avec docker-compose : postgresql://missionops:missionops@localhost:5432/missionops
DATABASE_URL="postgresql://missionops:missionops@localhost:5432/missionops"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentification (B1.5)
# Sessions par jetons opaques hachés en base : aucun secret de signature requis.
# Un vrai transport d'e-mail (lien magique / réinitialisation) sera ajouté plus
# tard ; en développement, le lien est journalisé côté serveur.

# Stockage objet compatible S3 (région UE, à définir en B3.6)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Sentry (région UE, à définir en B8.4)
# SENTRY_DSN=""

# --- Staging Fly.io (B1.12) -------------------------------------------------
# Le déploiement (.github/workflows/deploy.yml) attend deux secrets GitHub :
#   STAGING_DATABASE_URL : chaîne de connexion Postgres du staging (migrations)
#   FLY_API_TOKEN        : jeton de déploiement Fly.io
# Et deux secrets Fly, à définir sur l'application :
#   fly secrets set DATABASE_URL="postgres://…"
#   fly secrets set NEXT_PUBLIC_APP_URL="https://missionops-staging.fly.dev"

